<Window x:Class="DCCExpressHub.V2.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DCCExpressHub V2" Width="1200" Height="800" MinWidth="700" MinHeight="480"
        Background="#10161E" WindowStartupLocation="CenterScreen">
    <Grid>
        <wv:WebView2 x:Name="Browser" Visibility="Collapsed" />
        <TextBlock x:Name="StatusText" Text="Starting DCCExpressHub V2..."
                   Foreground="#EAF0F6" FontSize="17"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>
