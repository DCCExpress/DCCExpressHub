<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>DCCExpress HUB</ApplicationTitle>
    <ApplicationId>hu.dccexpress.hub</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DCCExpressHub.Runtime/DCCExpressHub.Runtime.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <MauiIcon Include="Resources/AppIcon/appicon.png" />
    <MauiAsset Include="Resources/Raw/*" />
  </ItemGroup>
  <ItemGroup>
    <MauiAsset Include="../DCCExpressHub.Net/wwwroot/**/*"
               LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
