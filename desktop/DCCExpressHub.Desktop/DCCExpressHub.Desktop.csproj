<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\DCCExpressHub.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DCCExpressHub.Runtime/DCCExpressHub.Runtime.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <!-- Startup settings now live inside MainWindow. Keep the legacy files in the
       repository temporarily, but exclude them from the build so there is only
       one authoritative implementation. -->
  <ItemGroup>
    <Page Remove="StartupSettingsWindow.xaml" />
    <Compile Remove="StartupSettingsWindow.xaml.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\DCCExpressHub.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../DCCExpressHub.Net/wwwroot/**/*">
      <Link>backend/wwwroot/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
</Project>
