<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <!-- Startup settings now live inside MainWindow. Keep the legacy files in the
       repository temporarily, but exclude them from the build so there is only
       one authoritative implementation. -->
  <ItemGroup>
    <Page Remove="StartupSettingsWindow.xaml" />
    <Compile Remove="StartupSettingsWindow.xaml.cs" />
  </ItemGroup>

  <Target Name="BuildBackend" BeforeTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <MSBuild Projects="..\DCCExpressHub.Net\DCCExpressHub.Net.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="PrepareBackendRuntime" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
    <!-- Never delete the whole backend directory during an ordinary VS build.
         A running backend locks DCCExpressHub.Net.dll on Windows. -->
    <MakeDir Directories="$(OutDir)backend" />

    <ItemGroup>
      <BackendFiles Include="..\DCCExpressHub.Net\bin\$(Configuration)\net10.0\**\*" />
      <WebRootFiles Include="..\DCCExpressHub.Net\wwwroot\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(BackendFiles)"
          DestinationFiles="@(BackendFiles->'$(OutDir)backend\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Retries="3"
          RetryDelayMilliseconds="250" />

    <Copy SourceFiles="@(WebRootFiles)"
          DestinationFiles="@(WebRootFiles->'$(OutDir)backend\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Retries="3"
          RetryDelayMilliseconds="250" />
  </Target>
</Project>
