    "z": "dccex0000000001",
    "name": "Build Z21 packet + hex debug",
    "func": "if (!Array.isArray(msg.payload)) return null; const packet = Buffer.from(msg.payload); msg.payload = packet; msg.hex = packet.toString('hex').toUpperCase(); return [msg, {payload:'TX '+msg.hex}];",
