{
  "name": "dccexpress-hub-web-ui",
  "version": "0.1.0-alpha.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo:seed": "node tools/prepare-demo-seed.mjs",
    "dev:demo": "npm run demo:seed && vite --mode demo",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:demo": "npm run demo:seed && npm run typecheck && vite build --mode demo",
    "embed": "npm run build && node tools/embed.mjs"
  },
  "dependencies": {
    "@mantine/core": "^9.1.1",
    "@mantine/notifications": "^9.1.1",
    "@tabler/icons-react": "^3.42.0",
    "i18next": "^26.0.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.8"
  }
}
