{
  "title": "DCC-EX Native / Serial Command Quick Reference",
  "intro": "Compact reference for official EX-CommandStation native/serial commands. Commands are case-sensitive at the opcode and must be enclosed in < and >.",
  "sourceLabel": "Official DCC-EX Serial Commands Full List",
  "sourceUrl": "https://dcc-ex.com/mkdocs-test/reference/serial-commands/serial-command-list/",
  "sourceNote": "The official list is generated from the CommandStation-EX command parser. Check the source for firmware-version-specific details and newly added commands.",
  "conventions": [
    "All commands must start with < and end with >.",
    "The first opcode character is case-sensitive; keyword parameters are not case-sensitive.",
    "Numeric parameters are decimal unless the official reference says otherwise.",
    "Not every command returns a direct response; many state changes are broadcast to all connected clients."
  ],
  "categories": [
    {
      "title": "System, status & power",
      "commands": [
        {
          "syntax": "<s>",
          "description": "Request EX-CommandStation version/status and defined turnout states."
        },
        {
          "syntax": "<#>",
          "description": "Request the maximum number of simultaneously supported locomotives."
        },
        {
          "syntax": "<J I>",
          "description": "Report track currents."
        },
        {
          "syntax": "<0>",
          "description": "Power OFF all tracks."
        },
        {
          "syntax": "<1>",
          "description": "Power ON all tracks."
        },
        {
          "syntax": "<0 MAIN> / <1 MAIN>",
          "description": "Power MAIN track OFF / ON."
        },
        {
          "syntax": "<0 PROG> / <1 PROG>",
          "description": "Power PROG track OFF / ON."
        },
        {
          "syntax": "<0 track> / <1 track>",
          "description": "Power the specified TrackManager output OFF / ON."
        },
        {
          "syntax": "<1 JOIN>",
          "description": "Join PROG to MAIN and power the joined output."
        },
        {
          "syntax": "<!>",
          "description": "Emergency-stop all locomotives."
        },
        {
          "syntax": "<! P>",
          "description": "Pause the layout using DCC-EX ESTOP pause."
        },
        {
          "syntax": "<! Q>",
          "description": "Query paused status."
        },
        {
          "syntax": "<! R>",
          "description": "Resume from ESTOP pause."
        },
        {
          "syntax": "<C RESET> / <D RESET>",
          "description": "Reset and restart the EX-CommandStation.",
          "danger": true
        }
      ]
    },
    {
      "title": "Locomotives, functions & consists",
      "commands": [
        {
          "syntax": "<t loco>",
          "description": "Request the current speed, direction and function state for a locomotive."
        },
        {
          "syntax": "<t loco tSpeed direction>",
          "description": "Set locomotive speed and direction. tSpeed is 0..127, with -1 used for emergency stop."
        },
        {
          "syntax": "<F loco function onoff>",
          "description": "Set a locomotive decoder function ON or OFF."
        },
        {
          "syntax": "<- loco>",
          "description": "Remove one locomotive from the state/reminder table."
        },
        {
          "syntax": "<->",
          "description": "Clear the locomotive state/reminder table."
        },
        {
          "syntax": "<^>",
          "description": "List active consists."
        },
        {
          "syntax": "<^ leadLoco follower [follower2..7]>",
          "description": "Create a consist with up to eight locomotive addresses; negative followers indicate reverse orientation."
        },
        {
          "syntax": "<^ loco>",
          "description": "Remove any consist containing this locomotive."
        },
        {
          "syntax": "<m loco momentum>",
          "description": "Set locomotive momentum with one combined value."
        },
        {
          "syntax": "<m loco accelerating braking>",
          "description": "Set separate acceleration and braking momentum."
        },
        {
          "syntax": "<m LINEAR>",
          "description": "Use linear momentum behaviour."
        },
        {
          "syntax": "<m POWER>",
          "description": "Use power-curve momentum behaviour."
        },
        {
          "syntax": "<f loco ...>",
          "description": "Legacy function-group command; use <F loco function onoff> instead.",
          "deprecated": true
        }
      ]
    },
